# Omnara API token: a personal access token (account menu > Personal tokens in
# https://app.omnara.com) from an organization admin or owner, or an
# organization API key with the admin role (API Tokens page).
OMNARA_API_KEY=

# Daytona API key with the write:sandboxes and delete:sandboxes permissions,
# used by `npm run setup`. Create one at https://app.daytona.io/dashboard/keys
DAYTONA_API_KEY=

# Optional: the organization to use when the key can reach more than one.
# OMNARA_ORG_ID=
